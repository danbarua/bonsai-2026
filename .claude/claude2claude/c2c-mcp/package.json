{
  "name": "c2c-mcp",
  "version": "0.6.0",
  "description": "Local HTTP MCP server for the claude2claude / claude2gpt filesystem mailboxes",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "build-proxy": "tsc -p tsconfig.proxy.json && mv dist-proxy/proxy.js dist-proxy/proxy.cjs"
  },
  "keywords": [],
  "type": "module",
  "private": "true",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
