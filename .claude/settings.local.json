{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-tool-call.py"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(claude agents *)",
      "Bash(claude mcp *)",
      "mcp__pycharm__*",
      "mcp__pycharm-debugger__*",
      "mcp__mighty-colab__*",
      "mcp__claude-in-chrome__*",
      "mcp__claude_ai_Gmail__*",
      "mcp__claude_ai_Google_Calendar__*",
      "mcp__claude_ai_Google_Drive__*",
      "mcp__ide__*"
    ]
  },
  "enableAllProjectMcpServers": true
}
