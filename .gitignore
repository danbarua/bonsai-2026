# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# JetBrains Documentation:
# https://intellij-support.jetbrains.com/hc/en-us/articles/206544839-How-to-manage-projects-under-Version-Control-Systems
# > Items you may want to exclude from sharing:
# > .iml files and .idea/modules.xml file for the Gradle or Maven based projects since these files will be generated on import
.idea/*.iml

# Ruff stuff:
.ruff_cache/

# PyPI configuration file
.pypirc

**.DS_STORE
.conda

plots/**/*.png
tests/plots/**/*.png
output/**

# Bonsai-specific: raw datasets and cached experiment results are large
# binary artifacts, regenerable from code + downloaded data. Keep folder
# structure via .gitkeep, exclude actual content.
datasets/*/
!datasets/.gitkeep
*.pkl
*.npz
*.npy


# Stage 2A: local scratch directory for large encode/evolve artifacts
# (stage2a_paths.py's default STAGE2A_SCRATCH_ROOT) -- regenerable by
# re-running the encode/evolve pipeline, never committed.
experiments/stage2a_dynamics_classification/scratch/


# Claude Code: personal/local tool permissions and settings -- kept on
# disk, not tracked. The SHARED .claude/settings.json (project-wide hook
# registrations) is tracked; only this per-machine overlay is ignored.
.claude/settings.local.json


# GCP service-account keys (Stage 2B's Colab/GCS access). These are live
# credentials, not config: anyone holding one has the service account's
# bucket permissions. `gcloud iam service-accounts keys create <name>.json`
# writes to the CURRENT directory, so the repo root is exactly where one
# lands by default -- hence the broad patterns rather than one filename.
# Upload the key to the Colab session directly; never commit it.
bonsai-colab-storage-key.json
*-storage-key.json
*service-account*.json
gcp-*-key.json


# Claude Code <-> Claude Desktop/ChatGPT/Claude Code filesystem mailbox: a
# local, personal experiment. The c2c-mcp server that reads/writes it
# (.claude/claude2claude/c2c-mcp/) IS real project tooling and stays
# tracked -- only the mailbox message directories are ignored here, not
# the whole claude2claude/ tree. code2code/ is the Code-to-Code channel
# (no fixed peer role, unlike claude2claude/claude2gpt) -- a single shared
# mailbox/ dir, not a inbox/outbox split, since every party on it is a
# Claude Code session.
.claude/claude2claude/inbox/
.claude/claude2claude/outbox/
.claude/claude2claude/archive/
.claude/claude2gpt/inbox/
.claude/claude2gpt/outbox/
.claude/claude2gpt/archive/
# Digests of the above, same reasoning as the code2code summaries below:
# derived entirely from a local-only archive, so a committed digest would be
# a durable record nobody else can regenerate or check against its source.
.claude/claude2gpt/mailbox-summaries/
.claude/code2code/mailbox/
.claude/code2code/archive/
# Digests written by the summarise-mailbox skill, plus its checkpoint
# manifest. Derived entirely from archive/ above, which is itself local-
# only -- a committed digest would be a durable record nobody else can
# regenerate or check against its source.
.claude/code2code/mailbox-summaries/

# work-and-mail-loop skill: per-session iteration logs, one file per
# /rename name. Ephemeral scratch, not durable project record.
.claude/logs/work-and-mail-loop/

# Node.js dependencies (c2c-mcp server)
node_modules/
.claude/claude2claude/c2c-mcp/dist-proxy/
.claude/claude2claude/c2c-mcp/logs/

# c2c-mcp's OAuth HMAC signing key (self-generated on first run, a live
# credential -- anyone with it can forge access tokens for the connector).
.claude/claude2claude/c2c-mcp/.data/

# The generic `lib/` rule above (Python packaging boilerplate) has no
# leading slash, so it also matches .claude/hooks/c2c-mail/lib/ -- real
# tracked shell code, not a packaging artifact. Un-ignore it explicitly.
!.claude/hooks/c2c-mail/lib/

# Provenance probe scratch: generated settings + observation logs from
# tools/provenance/run_truncation_probe.py. Regenerable by running it.
.provenance/

# Terraform (infra/). State is in GCS, so a local .tfstate here means the
# backend was not initialised -- ignored so it cannot be committed by
# accident, since it enumerates every service account and IAM binding.
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
.terraformrc
terraform.rc
# .terraform.lock.hcl is NOT ignored, deliberately: it is a lockfile, not
# state, and it is what actually pins the provider build. `~> 7.0` in
# versions.tf is the policy; the lockfile is the fact.
